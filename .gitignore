.DS_Store
.pytest_cache/
.ruff_cache/
.venv/
__pycache__/
*.py[cod]

# API responses are reproducible caches, not source data.
data/cache/

# Paper PDFs can be large and have heterogeneous licenses. Keep them local.
data/papers/
data/figures/

# Review galleries derive local page images from heterogeneously licensed PDFs.
data/adjudicated/*/images/
data/adjudicated/*/index.html

# Interrupted downloads.
*.part

# Resumable evaluator checkpoints contain incomplete generated reports.
*.checkpoint.jsonl
